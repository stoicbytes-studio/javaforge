# Copy to .env and fill in. All values are public (bundled into the client).
# Never add the Supabase service-role key to this app.

# Supabase project (optional — without it the app runs in local-only mode)
EXPO_PUBLIC_SUPABASE_URL=
EXPO_PUBLIC_SUPABASE_ANON_KEY=

# Java execution service (optional — without it the playground uses simulation mode)
# e.g. http://localhost:8080 when running executor/ locally
EXPO_PUBLIC_EXECUTOR_URL=
