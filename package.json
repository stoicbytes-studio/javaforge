{
  "name": "javaforge",
  "version": "0.1.0",
  "main": "expo-router/entry",
  "dependencies": {
    "@expo/metro-runtime": "~58.0.14",
    "@hookform/resolvers": "^5.9.2",
    "@monaco-editor/react": "^4.7.0",
    "@react-native-async-storage/async-storage": "^2.2.0",
    "@supabase/supabase-js": "^2.118.0",
    "@tanstack/react-query": "^5.104.4",
    "expo": "~58.0.14",
    "expo-clipboard": "~58.0.3",
    "expo-constants": "~58.0.12",
    "expo-linking": "~58.0.13",
    "expo-router": "~58.0.23",
    "expo-status-bar": "~58.0.3",
    "monaco-editor": "^0.57.0",
    "react": "19.3.0",
    "react-dom": "^19.3.0",
    "react-hook-form": "^7.90.0",
    "react-native": "0.88.0",
    "react-native-safe-area-context": "~5.10.1",
    "react-native-screens": "~4.30.0",
    "react-native-svg": "^15.16.0",
    "react-native-url-polyfill": "^4.0.0",
    "react-native-web": "^0.21.4",
    "zod": "^4.6.7",
    "zustand": "^5.0.15"
  },
  "devDependencies": {
    "@playwright/test": "^1.64.1",
    "@react-native/jest-preset": "^0.88.0",
    "@testing-library/react-native": "^14.1.0",
    "@types/jest": "^30.0.0",
    "@types/react": "~19.3.0",
    "eslint": "^9.39.5",
    "eslint-config-expo": "~58.0.4",
    "jest": "^30.5.2",
    "jest-expo": "~58.0.11",
    "serve": "^14.2.6",
    "test-renderer": "^1.3.1",
    "typescript": "~6.0.3"
  },
  "scripts": {
    "start": "expo start",
    "web": "expo start --web",
    "android": "expo start --android",
    "ios": "expo start --ios",
    "typecheck": "tsc --noEmit",
    "test": "jest",
    "verify:java": "node --disable-warning=MODULE_TYPELESS_PACKAGE_JSON scripts/verify-java-content.mjs",
    "copy:monaco": "node scripts/copy-monaco.mjs",
    "export:web": "node scripts/copy-monaco.mjs && expo export --platform web",
    "e2e": "playwright test",
    "postinstall": "node scripts/copy-monaco.mjs",
    "seed:generate": "node --disable-warning=MODULE_TYPELESS_PACKAGE_JSON scripts/generate-seed.mjs",
    "test:db": "bash supabase/tests/run.sh",
    "e2e:build": "node scripts/copy-monaco.mjs && EXPO_PUBLIC_SUPABASE_URL=http://127.0.0.1:54321 EXPO_PUBLIC_SUPABASE_ANON_KEY=e2e-anon-key EXPO_PUBLIC_EXECUTOR_URL= expo export --platform web --output-dir dist-e2e",
    "lint": "expo lint"
  },
  "private": true,
  "jest": {
    "preset": "jest-expo",
    "moduleNameMapper": {
      "^@/(.*)$": "<rootDir>/src/$1"
    },
    "testPathIgnorePatterns": [
      "/node_modules/",
      "/e2e/",
      "/executor/"
    ],
    "setupFiles": [
      "<rootDir>/jest.setup.js"
    ]
  },
  "engines": {
    "node": ">=20"
  }
}
